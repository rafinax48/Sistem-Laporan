generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ReportKind {
  STUDENT
  REFERENCE
}

model Practicum {
  id            String    @id @default(cuid())
  name          String
  slot          String
  totalMeetings Int       @default(8)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  students      Student[]
  reports       Report[]

  @@index([name])
}

model Student {
  id          String     @id @default(cuid())
  practicumId String
  practicum   Practicum  @relation(fields: [practicumId], references: [id], onDelete: Cascade)
  name        String
  nim         String
  className   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  reports     Report[]

  @@index([practicumId])
  @@index([nim])
}

model Report {
  id            String      @id @default(cuid())
  kind          ReportKind
  topic         String?
  studentName   String?
  fileName      String
  filePath      String
  fileType      String
  rawText       String?
  practicumId   String?
  practicum     Practicum?  @relation(fields: [practicumId], references: [id], onDelete: SetNull)
  studentId     String?
  student       Student?    @relation(fields: [studentId], references: [id], onDelete: SetNull)
  meetingNumber Int?
  createdAt     DateTime    @default(now())

  subjectOf Assessment?  @relation("Subject")
  usedAsRef Assessment[] @relation("Reference")

  @@index([kind])
  @@index([topic])
  @@index([practicumId])
  @@index([studentId])
}

model Assessment {
  id                String     @id @default(cuid())
  reportId          String     @unique
  report            Report     @relation("Subject", fields: [reportId], references: [id], onDelete: Cascade)
  referenceReportId String?
  referenceReport   Report?    @relation("Reference", fields: [referenceReportId], references: [id])
  overallScore      Int?
  categories        AssessmentCategory[]
  findings          AssessmentFinding[]
  createdAt         DateTime   @default(now())
}

model AssessmentCategory {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  name         String
  score        Int
  comment      String
  suggestion   String

  @@index([assessmentId])
}

model AssessmentFinding {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  page         Int?
  section      String?
  line         Int?
  quote        String?
  issue        String
  suggestion   String
  createdAt    DateTime   @default(now())

  @@index([assessmentId])
}

